// NobleBid — Prisma schema.
//  - Member = bidder, auctioneer or super admin. Login is email + password;
//    email OTP is used only to verify the email at signup and for forgot-password.
//  - Money amounts are integer paise.
//  - Idempotency keys on money paths prevent double credit/charge.

// Prisma 7: `prisma-client` generator emits a Rust-free TypeScript client.
// Connection URL lives in prisma.config.ts (CLI) and src/core/prisma/client.ts (runtime adapter).
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum Role {
  BIDDER
  AUCTIONEER
  SUPER_ADMIN
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

enum BidKind {
  MANUAL
  AUTO
  BUY_NOW
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  USED
  FOR_PARTS
}

enum CommissionStatus {
  DUE
  PAID
  WAIVED
}

enum OtpChannel {
  EMAIL
  SMS // unused, kept because Postgres cannot drop enum values
}

enum OtpPurpose {
  SIGNUP
  PASSWORD_RESET
  PHONE_VERIFY // unused, kept because Postgres cannot drop enum values
}

// ----------------------------------------------------------------------------
// MEMBERS & AUTH
// ----------------------------------------------------------------------------

model Member {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  passwordHash          String
  phone                 String?
  avatarUrl             String?
  address               String?
  role                  Role      @default(BIDDER)
  isActive              Boolean   @default(true)
  emailVerifiedAt       DateTime?
  // Verified-seller badge (see members/verification.service.ts); admin revoke wins over the rule.
  verifiedAt            DateTime?
  verificationRevokedAt DateTime?
  // Commission the auctioneer owes the platform owes the platform for sold auctions (paise).
  unpaidCommissionPaise BigInt    @default(0)
  // Bidder stats.
  auctionsWon           Int       @default(0)
  moneySpentPaise       BigInt    @default(0)
  // Seller rating totals; only non-hidden reviews count.
  ratingCount           Int       @default(0)
  ratingSum             Int       @default(0)
  // Followers of this seller (kept in step with Follow rows in the same transaction).
  followerCount         Int       @default(0)
  // Referral code (8-char uppercase base32), generated lazily; GST details for invoices.
  referralCode          String?   @unique
  gstin                 String?
  billingState          String? // 2-digit GST state code
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sessions          Session[]
  paymentOrders     PaymentOrder[]
  wsConnections     WsConnection[]
  wsTickets         WsTicket[]
  pushSubscriptions PushSubscription[]

  auctionsSelling Auction[]            @relation("AuctionSeller")
  auctionsLeading Auction[]            @relation("AuctionHighestBidder")
  auctionsWonList Auction[]            @relation("AuctionWinner")
  bids            Bid[]
  maxBids         MaxBid[]
  watchlist       Watchlist[]
  commissions     Commission[]
  notifications   Notification[]
  payoutAccount   SellerPayoutAccount?
  purchases       Sale[]               @relation("Purchases")
  sales           Sale[]               @relation("Sales")

  reviewsReceived Review[]          @relation("ReviewsReceived")
  reviewsWritten  Review[]          @relation("ReviewsWritten")
  questions       AuctionQuestion[]
  savedSearches   SavedSearch[]
  reportsFiled    Report[]

  deposits             AuctionDeposit[]
  strikes              Strike[]
  secondChanceOffers   SecondChanceOffer[]
  shillSignalsAsBidder ShillSignal[]       @relation("ShillBidder")
  shillSignalsAsSeller ShillSignal[]       @relation("ShillSeller")

  following               Follow[]                 @relation("Following")
  followers               Follow[]                 @relation("Followers")
  notificationPreferences NotificationPreference[]

  featurePurchases FeaturePurchase[]
  referralsMade    Referral[]        @relation("ReferralsMade")
  referredBy       Referral?         @relation("ReferredBy")
  credits          MemberCredit[]
  invoices         Invoice[]

  @@index([role])
}

// One row per logged-in device. The access/refresh JWTs carry this row's id
// as their `sid` claim — `authenticate` (and `refresh`) look the row up on
// every call, so deleting it revokes those tokens immediately even though
// the JWTs themselves stay cryptographically valid until natural expiry.
// Capped at MAX_DEVICES_PER_MEMBER (session.service.ts).
model Session {
  id         String   @id @default(cuid())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId   String
  deviceId   String // server-generated (or reused from the `dvid` cookie) — identifies "this browser".
  deviceInfo Json? // {browser, os, device, type}
  userAgent  String?
  ip         String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  pushSubscriptions PushSubscription[]

  @@unique([memberId, deviceId])
  @@index([memberId, createdAt])
}

// Short-lived email verification challenge, scoped by channel + purpose
// (signup email verification, forgot-password). No FK to Member — a signup
// email may be brand new.
model OtpChallenge {
  id          String     @id @default(cuid())
  identifier  String // lowercased email
  channel     OtpChannel @default(EMAIL)
  purpose     OtpPurpose @default(SIGNUP)
  // Plaintext code alongside otpHash — lets a repeat request within the TTL
  // resend the SAME code (see otp-challenge.service.ts).
  code        String
  otpHash     String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([identifier, channel, purpose, createdAt])
  @@index([expiresAt])
}

// ----------------------------------------------------------------------------
// AUCTIONS, BIDS, WATCHLIST, COMMISSIONS (money = integer paise)
// ----------------------------------------------------------------------------

model Auction {
  id                String        @id @default(cuid())
  title             String
  description       String // rich text, sanitised before save
  category          String // denormalised Category.name, always written together with categoryId
  categoryRef       Category?     @relation("AuctionCategory", fields: [categoryId], references: [id])
  categoryId        String?
  attributes        Json? // validated against Category.attributeSchema; GIN index in migration SQL only
  condition         ItemCondition
  conditionReport   String? // rich text (sanitised), max 5000 chars
  estimateLowPaise  BigInt?
  estimateHighPaise BigInt?
  images            String[] // CloudFront URLs, first = cover
  videoUrl          String? // uploaded auction-videos object
  shippingOptions   Json? // { pickup, pickupCity?, courier, shippingFeePaise?, shipsWithinDays? }
  startingBidPaise  BigInt
  minIncrementPaise BigInt
  currentBidPaise   BigInt        @default(0)
  reservePricePaise BigInt? // hidden from everyone but the seller / admin; null = no reserve
  buyNowPricePaise  BigInt? // null = Buy It Now off
  depositPaise      BigInt? // refundable bid deposit; null = none
  bidCount          Int           @default(0)
  startTime         DateTime
  endTime           DateTime
  status            AuctionStatus @default(SCHEDULED)
  seller            Member        @relation("AuctionSeller", fields: [sellerId], references: [id])
  sellerId          String
  highestBidder     Member?       @relation("AuctionHighestBidder", fields: [highestBidderId], references: [id])
  highestBidderId   String?
  winner            Member?       @relation("AuctionWinner", fields: [winnerId], references: [id])
  winnerId          String?
  endedAt           DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  // Paid featured listing runs until this time (capped at endTime); null = never featured.
  featuredUntil     DateTime?

  bids               Bid[]
  maxBids            MaxBid[]
  watchlist          Watchlist[]
  commission         Commission?
  review             Review?
  sales              Sale[]
  questions          AuctionQuestion[]
  deposits           AuctionDeposit[]
  secondChanceOffers SecondChanceOffer[]
  shillSignals       ShillSignal[]
  statsDaily         AuctionStatDaily[]
  featurePurchases   FeaturePurchase[]

  @@index([status, endTime])
  @@index([featuredUntil])
  @@index([status, startTime])
  @@index([sellerId])
  @@index([category, status])
  @@index([categoryId])
}

// Category tree (self relation). Replaces the AppSetting `auction.categories` list (decision D13).
model Category {
  id              String     @id @default(cuid())
  slug            String     @unique
  name            String
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  parentId        String?
  children        Category[] @relation("CategoryTree")
  sortOrder       Int        @default(0)
  isActive        Boolean    @default(true)
  description     String?
  attributeSchema Json       @default("[]") // AttributeDef[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  auctions Auction[] @relation("AuctionCategory")

  @@index([parentId])
}

model Bid {
  id          String   @id @default(cuid())
  auction     Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId   String
  bidder      Member   @relation(fields: [bidderId], references: [id])
  bidderId    String
  amountPaise BigInt
  kind        BidKind  @default(MANUAL)
  createdAt   DateTime @default(now())

  @@index([auctionId, amountPaise(sort: Desc)])
  @@index([bidderId, createdAt])
}

// A bidder's private maximum on an auction (proxy bidding). Never exposed to other members.
model MaxBid {
  auction        Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId      String
  bidder         Member   @relation(fields: [bidderId], references: [id])
  bidderId       String
  maxAmountPaise BigInt
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@id([auctionId, bidderId])
}

model Watchlist {
  member               Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId             String
  auction              Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId            String
  createdAt            DateTime  @default(now())
  endingSoonNotifiedAt DateTime?

  @@id([memberId, auctionId])
}

model Commission {
  id             String           @id @default(cuid())
  auction        Auction          @relation(fields: [auctionId], references: [id])
  auctionId      String           @unique
  seller         Member           @relation(fields: [sellerId], references: [id])
  sellerId       String
  rateBps        Int // 500 = 5%
  amountPaise    BigInt
  status         CommissionStatus @default(DUE)
  dueAt          DateTime
  paidAt         DateTime?
  waivedNote     String? // admin's reason when waived; admin DTO only
  paymentOrder   PaymentOrder?    @relation(fields: [paymentOrderId], references: [id])
  paymentOrderId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([sellerId, status])
}

// ----------------------------------------------------------------------------
// IN-APP NOTIFICATIONS
// ----------------------------------------------------------------------------

// Bell-icon inbox. `dedupeKey` (e.g. `outbid:<bidId>:<memberId>`) makes the
// notify pipeline idempotent: a second delivery of the same event is a no-op.
model Notification {
  id        String    @id @default(cuid())
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  type      String
  title     String
  body      String
  url       String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([memberId, readAt, createdAt])
}

// ----------------------------------------------------------------------------
// WEBSOCKET / PUSH / RATE LIMIT
// ----------------------------------------------------------------------------

// One row per open socket. `id` IS the API Gateway connectionId. memberId is
// optional (guests may connect); auctionId is the auction room the socket
// subscribed to (plain column, no foreign key).
model WsConnection {
  id          String   @id
  member      Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    String?
  auctionId   String?
  connectedAt DateTime @default(now())

  @@index([memberId])
  @@index([auctionId])
}

// Short-lived, single-use ticket standing in for the access token on the
// WebSocket handshake (`POST /ws/ticket`, then `wss://...?ticket=...`).
model WsTicket {
  id        String    @id @default(cuid())
  member    Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

// One row per browser Web Push subscription; cascade-deleted with the login
// Session that registered it. `endpoint` is unique per browser (upsert).
model PushSubscription {
  id        String   @id @default(cuid())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([memberId])
  @@index([sessionId])
}

// Shared express-rate-limit counters (src/core/middleware/pgRateLimitStore.ts),
// fixed window, shared across Lambda containers. Swept by the retention job.
model RateLimitBucket {
  key     String   @id
  hits    Int
  resetAt DateTime

  @@index([resetAt])
}

// ----------------------------------------------------------------------------
// PAYMENTS (Razorpay one-time Orders API)
// ----------------------------------------------------------------------------

model PaymentOrder {
  id               String        @id @default(cuid())
  member           Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId         String
  gatewayOrderId   String        @unique // razorpay order id (or stub id)
  amountPaise      BigInt
  status           PaymentStatus @default(CREATED)
  // What the order pays for (e.g. 'COMMISSION' + its id) — set when the order is created.
  referenceType    String?
  referenceId      String?
  // Razorpay payment id that settled the order (set when marked PAID).
  gatewayPaymentId String?
  idempotencyKey   String        @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  commissions Commission[]

  @@index([memberId])
}

model WebhookEvent {
  id             String   @id @default(cuid())
  gatewayEventId String   @unique
  type           String
  payload        Json
  processedAt    DateTime @default(now())
}

// ----------------------------------------------------------------------------
// APP SETTINGS
// ----------------------------------------------------------------------------

// Admin-managed key/value config. `value` is TEXT, parsed in code.
model AppSetting {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt
}

// One review per ended auction, written by the winner about the seller.
model Review {
  id              String    @id @default(cuid())
  auction         Auction   @relation(fields: [auctionId], references: [id])
  auctionId       String    @unique
  seller          Member    @relation("ReviewsReceived", fields: [sellerId], references: [id])
  sellerId        String
  reviewer        Member    @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  reviewerId      String
  rating          Int
  comment         String?
  sellerReply     String?
  sellerRepliedAt DateTime?
  hiddenAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([sellerId, hiddenAt, createdAt])
}

// A public question on a lot, answered once by the seller.
model AuctionQuestion {
  id         String    @id @default(cuid())
  auction    Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId  String
  asker      Member    @relation(fields: [askerId], references: [id])
  askerId    String
  question   String
  answer     String?
  answeredAt DateTime?
  hiddenAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([auctionId, createdAt])
}

// A bidder's saved browse filter; matching new listings notify the member.
model SavedSearch {
  id            String         @id @default(cuid())
  member        Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId      String
  name          String?
  q             String?
  category      String?
  condition     ItemCondition?
  minPricePaise BigInt?
  maxPricePaise BigInt?
  createdAt     DateTime       @default(now())

  @@index([memberId])
  @@index([category])
}

// ----------------------------------------------------------------------------
// CHECKOUT (Razorpay Route): winner pays in-app, funds held, released to the seller
// ----------------------------------------------------------------------------

enum PayoutStatus {
  PENDING
  NEEDS_CLARIFICATION
  ACTIVE
  SUSPENDED
  REJECTED
}

// One Razorpay Route linked account per seller. PAN and the full bank account number are NEVER stored.
model SellerPayoutAccount {
  id                String       @id @default(cuid())
  seller            Member       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId          String       @unique
  razorpayAccountId String       @unique
  productId         String?
  status            PayoutStatus @default(PENDING)
  statusReason      String?
  legalName         String
  businessType      String
  bankLast4         String
  ifsc              String
  beneficiaryName   String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

enum SaleStatus {
  AWAITING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  RELEASED
  DISPUTED
  REFUNDED
  CANCELLED
}

model Sale {
  id               String     @id @default(cuid())
  auction          Auction    @relation(fields: [auctionId], references: [id])
  auctionId        String
  buyer            Member     @relation("Purchases", fields: [buyerId], references: [id])
  buyerId          String
  seller           Member     @relation("Sales", fields: [sellerId], references: [id])
  sellerId         String
  itemPaise        BigInt
  shippingFeePaise BigInt     @default(0)
  deliveryChoice   String? // 'COURIER' | 'PICKUP', set at checkout
  amountPaise      BigInt
  commissionPaise  BigInt
  rateBps          Int
  status           SaleStatus @default(AWAITING_PAYMENT)
  payBy            DateTime
  paidAt           DateTime?
  gatewayPaymentId String?
  transferId       String?
  shippingMethod   String? // 'COURIER' | 'PICKUP'
  courier          String?
  trackingNo       String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  releasedAt       DateTime?
  disputedAt       DateTime?
  disputeReason    String?
  resolvedAt       DateTime?
  resolution       String?
  refundedAt       DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  strike            Strike?
  secondChanceOffer SecondChanceOffer?

  // Partial unique index "Sale_open_per_auction" (one open sale per auction) lives in the migration SQL only.
  @@index([auctionId])
  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, payBy])
  @@index([status, shippedAt])
}

// ----------------------------------------------------------------------------
// TRUST: reports
// ----------------------------------------------------------------------------

enum ReportTargetType {
  AUCTION
  MEMBER
  REVIEW
  QUESTION
}

enum ReportReason {
  COUNTERFEIT
  PROHIBITED
  MISLEADING
  SPAM
  ABUSE
  OTHER
}

enum ReportStatus {
  OPEN
  ACTION_TAKEN
  DISMISSED
}

model Report {
  id           String           @id @default(cuid())
  reporter     Member           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId   String
  targetType   ReportTargetType
  targetId     String
  reason       ReportReason
  details      String?
  status       ReportStatus     @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  note         String?
  createdAt    DateTime         @default(now())

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// ----------------------------------------------------------------------------
// TRUST 2: bid deposits, strikes, second-chance offers, shill-bid signals
// ----------------------------------------------------------------------------

enum DepositStatus {
  PENDING
  HELD
  REFUNDED
  FORFEITED
}

// Refundable deposit a bidder pays before bidding on a high-value auction (or after 2 strikes).
model AuctionDeposit {
  id               String        @id @default(cuid())
  auction          Auction       @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId        String
  member           Member        @relation(fields: [memberId], references: [id])
  memberId         String
  amountPaise      BigInt
  status           DepositStatus @default(PENDING)
  paymentOrderId   String?       @unique
  gatewayPaymentId String?
  refundId         String?
  heldAt           DateTime?
  refundedAt       DateTime?
  forfeitedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([auctionId, memberId])
  @@index([status])
}

enum StrikeReason {
  UNPAID
}

// One strike per cancelled (unpaid) sale; active = not removed and not expired (12 months).
model Strike {
  id          String       @id @default(cuid())
  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId    String
  sale        Sale         @relation(fields: [saleId], references: [id])
  saleId      String       @unique
  reason      StrikeReason
  createdAt   DateTime     @default(now())
  expiresAt   DateTime
  removedAt   DateTime?
  removedById String?
  note        String?

  @@index([memberId, expiresAt])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// Second-chance offer to the runner-up after a sale was cancelled for non-payment.
model SecondChanceOffer {
  id          String      @id @default(cuid())
  sale        Sale        @relation(fields: [saleId], references: [id])
  saleId      String      @unique
  auction     Auction     @relation(fields: [auctionId], references: [id])
  auctionId   String
  bidder      Member      @relation(fields: [bidderId], references: [id])
  bidderId    String
  amountPaise BigInt
  status      OfferStatus @default(PENDING)
  expiresAt   DateTime
  respondedAt DateTime?
  newSaleId   String?
  createdAt   DateTime    @default(now())

  @@index([bidderId, status])
  @@index([status, expiresAt])
}

enum RiskOutcome {
  DISMISSED
  ACTION_TAKEN
}

// Review-only shill-bid flag (never blocks anything).
model ShillSignal {
  id           String       @id @default(cuid())
  auction      Auction      @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId    String
  bidder       Member       @relation("ShillBidder", fields: [bidderId], references: [id], onDelete: Cascade)
  bidderId     String
  seller       Member       @relation("ShillSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId     String
  score        Int
  reasons      Json
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  reviewedAt   DateTime?
  reviewedById String?
  outcome      RiskOutcome?
  note         String?

  @@unique([auctionId, bidderId])
  @@index([reviewedAt, score])
}

// ----------------------------------------------------------------------------
// ENGAGEMENT: follow a seller, notification preferences, seller analytics
// ----------------------------------------------------------------------------

model Follow {
  follower   Member   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followerId String
  seller     Member   @relation("Followers", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId   String
  createdAt  DateTime @default(now())

  @@id([followerId, sellerId])
  @@index([sellerId])
}

// Per-member, per-notification-type channel switches. A missing row = defaults (email + push on).
model NotificationPreference {
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  type      String
  email     Boolean  @default(true)
  push      Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@id([memberId, type])
}

// Per-auction per-day (Asia/Kolkata) view counters.
model AuctionStatDaily {
  auction       Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId     String
  date          DateTime @db.Date
  views         Int      @default(0)
  uniqueViewers Int      @default(0)

  @@id([auctionId, date])
}

// Dedupe rows for unique-viewer counting (sha256 viewer key); no FK, purged after 30 days by the retention job.
model AuctionViewer {
  auctionId String
  viewerKey String
  date      DateTime @db.Date

  @@id([auctionId, viewerKey, date])
  @@index([date])
}

// ----------------------------------------------------------------------------
// ENGAGEMENT 2: paid featured listings, referral credits, GST invoices
// ----------------------------------------------------------------------------

enum FeatureStatus {
  PENDING
  PAID
  FAILED
}

// A seller's purchase of N days of featured placement on one auction.
model FeaturePurchase {
  id             String        @id @default(cuid())
  auction        Auction       @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId      String
  seller         Member        @relation(fields: [sellerId], references: [id])
  sellerId       String
  days           Int
  amountPaise    BigInt
  status         FeatureStatus @default(PENDING)
  paidWith       String? // 'RAZORPAY' | 'CREDITS'
  paymentOrderId String?       @unique
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([sellerId, createdAt])
  @@index([auctionId])
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
}

model Referral {
  id           String         @id @default(cuid())
  referrer     Member         @relation("ReferralsMade", fields: [referrerId], references: [id])
  referrerId   String
  referee      Member         @relation("ReferredBy", fields: [refereeId], references: [id])
  refereeId    String         @unique
  status       ReferralStatus @default(PENDING)
  qualifiedAt  DateTime?
  rewardedAt   DateTime?
  rejectReason String?
  createdAt    DateTime       @default(now())

  @@index([referrerId, status])
}

enum CreditReason {
  REFERRAL_REWARD
  FEATURE_PURCHASE
  COMMISSION_PAYMENT
  ADMIN_ADJUSTMENT
}

// Platform-credit ledger; balance = SUM(amountPaise). Debits are negative and never take the balance below 0.
model MemberCredit {
  id          String       @id @default(cuid())
  member      Member       @relation(fields: [memberId], references: [id])
  memberId    String
  amountPaise BigInt
  reason      CreditReason
  refType     String?
  refId       String?
  note        String?
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([memberId, createdAt])
}

enum InvoiceType {
  COMMISSION
  FEATURE
  DEPOSIT_FORFEIT
}

model InvoiceCounter {
  financialYear String @id
  seq           Int    @default(0)
}

model Invoice {
  id            String      @id @default(cuid())
  number        String      @unique
  financialYear String
  seq           Int
  type          InvoiceType
  refId         String
  member        Member      @relation(fields: [memberId], references: [id])
  memberId      String
  buyerName     String
  buyerGstin    String?
  buyerState    String?
  placeOfSupply String?
  taxablePaise  BigInt
  cgstPaise     BigInt
  sgstPaise     BigInt
  igstPaise     BigInt
  totalPaise    BigInt
  isTaxInvoice  Boolean
  issuedAt      DateTime
  pdfKey        String? // legacy: the PDF used to be cached in S3; it is now rendered per request, so this is unused
  createdAt     DateTime    @default(now())

  @@unique([type, refId])
  @@index([memberId, issuedAt])
}
