# ---- bids-api (NobleBid) PRODUCTION ----
# Copy to .env on the deploy target (or set as CI env vars). Never commit real values.
NODE_ENV=production
PORT=4000

# Allowed web origins (comma-separated). No trailing slash.
CORS_ORIGINS=https://app.example.com
# Public web app URL (links in emails).
APP_URL=https://app.example.com
# Super Admin / ops contact email.
ADMIN_EMAIL=admin@example.com
# Platform commission in basis points (500 = 5%).
COMMISSION_RATE_BPS=500

# Database — pooled URL for runtime, direct URL for migrations
DATABASE_URL=postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://USER:PASS@HOST:5432/postgres?sslmode=require

# Auth — MUST be strong (>=32 chars) and different. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_DOMAIN=example.com

# Storage (S3 + CloudFront). AWS_CLOUDFRONT_URL is filled in by the deploy workflow.
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=bids-prod-uploads
AWS_CLOUDFRONT_URL=

# Payments: razorpay in prod (one-time Orders API)
PAYMENT_DRIVER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email. EMAIL_DRIVER=ses for real delivery (Lambda execution role grants
# ses:SendEmail; no separate credentials). Boot refuses ses with the placeholder
# EMAIL_FROM. EMAIL_FROM must be a verified SES sender identity.
# The stub driver logs the code and always issues OTP_STUB_CODE.
EMAIL_DRIVER=ses
OTP_STUB_CODE=123456
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=NobleBid
# Public HTTPS URL to the brand logo shown in the email header (optional).
LOGO_URL=

# Seed (npm run prisma:seed): Super Admin created only when BOTH are set. Use a strong
# password; remove SEED_ADMIN_PASSWORD from the environment after the first seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Web Push (optional). Generate ONE pair with `npx web-push generate-vapid-keys`
# and never rotate it. VAPID_SUBJECT is a mailto: or https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://app.example.com

# Injected by serverless.yml on Lambda — leave unset locally:
#   WS_API_ENDPOINT, NOTIFY_QUEUE_URL

# Optional per-IP OTP rate-limit overrides (defaults 20).
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_OTP_IP_MAX=
