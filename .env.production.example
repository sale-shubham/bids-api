# ---- bids-api (NobleBid) PRODUCTION ----
# Copy to .env on the deploy target (or set as CI env vars). Never commit real values.
NODE_ENV=production
PORT=4000

# Allowed web origins for Express / local dev (comma-separated). Deployed CORS = provider.httpApi.cors.allowedOrigins in serverless.yml (keep in sync). No trailing slash. Include the marketing website (contact form POSTs /contact).
CORS_ORIGINS=https://bidsapp.shubsale.in,https://noblebids.shubsale.in
# Public web app URL (auction/commission links in emails).
APP_URL=https://bidsapp.shubsale.in
# Public marketing website URL (support/contact links in emails). Defaults to APP_URL.
WEBSITE_URL=https://noblebids.shubsale.in
# Super Admin / ops contact email.
ADMIN_EMAIL=admin@example.com
# Platform commission in basis points (500 = 5%).
COMMISSION_RATE_BPS=500

# Database — pooled URL for runtime, direct URL for migrations
DATABASE_URL=postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://USER:PASS@HOST:5432/postgres?sslmode=require

# Auth — MUST be strong (>=32 chars) and different. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
# Custom-domain mode: .shubsale.in (live on the dev stage: bidsapp.* + bidsapi.*). No-domain mode (Next.js rewrite): leave EMPTY -> host-only cookie.
COOKIE_DOMAIN=.shubsale.in
# lax (default) | none (cross-site only; forces Secure)
COOKIE_SAMESITE=lax

# Storage (S3 + CloudFront). AWS_CLOUDFRONT_URL is resolved by CloudFormation (serverless.yml) - never set it.
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=bids-prod-uploads

# Payments: razorpay in prod (one-time Orders API)
PAYMENT_DRIVER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email. EMAIL_DRIVER=ses for real delivery (Lambda execution role grants
# ses:SendEmail; no separate credentials). Boot refuses ses with the placeholder
# EMAIL_FROM. EMAIL_FROM must be a verified SES sender identity.
# The stub driver logs the code and always issues OTP_STUB_CODE.
EMAIL_DRIVER=ses
OTP_STUB_CODE=123456
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=NobleBid
# Public HTTPS URL to the brand logo shown in the email header (optional).
LOGO_URL=

# SMS (phone verification OTP only). SMS_DRIVER=stub logs a masked number (and the code outside production).
# msg91 needs a DLT-registered sender id + OTP template (India) and the MSG91 template id.
SMS_DRIVER=stub
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=

# WhatsApp alerts (opt-in; outbid / ending soon / won). WHATSAPP_DRIVER=stub logs a masked number and the template name.
# meta = WhatsApp Cloud API; needs a Business account, a phone number id, a permanent token and approved utility templates.
WHATSAPP_DRIVER=stub
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_OUTBID=nb_outbid
WHATSAPP_TEMPLATE_ENDING_SOON=nb_ending_soon
WHATSAPP_TEMPLATE_AUCTION_WON=nb_auction_won
WHATSAPP_TEMPLATE_SALE_PAYMENT_DUE=nb_sale_payment_due

# Two-factor auth. TOTP_ENC_KEY = 32 random bytes, base64 (`openssl rand -base64 32`); empty = 2FA setup returns 503.
# REQUIRE_ADMIN_2FA=true blocks /admin for Super Admins who have not enabled 2FA.
TOTP_ENC_KEY=
REQUIRE_ADMIN_2FA=false

# Seed (npm run prisma:seed): Super Admin created only when BOTH are set. Use a strong
# password; remove SEED_ADMIN_PASSWORD from the environment after the first seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Web Push (optional). Generate ONE pair with `npx web-push generate-vapid-keys`
# and never rotate it. VAPID_SUBJECT is a mailto: or https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://app.example.com

# Optional custom API domain (serverless.yml; both required to create it, ACM cert in ap-south-1).
# DISABLE_DEFAULT_ENDPOINT=true only AFTER the domain works (default false).
API_DOMAIN_NAME=
API_CERTIFICATE_ARN=
DISABLE_DEFAULT_ENDPOINT=false
# Optional: CloudWatch alarm emails.
ALERT_EMAIL=

# Injected by serverless.yml on Lambda (CloudFormation-resolved) — leave unset locally:
#   WS_API_ENDPOINT, NOTIFY_QUEUE_URL, AWS_CLOUDFRONT_URL
# Optional, local dev server only: override the ws:// URL given to clients
# (default ws://localhost:<PORT>/ws). Never needed on Lambda.
# WS_PUBLIC_URL=

# Optional per-IP OTP rate-limit overrides (defaults 20).
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_OTP_IP_MAX=
