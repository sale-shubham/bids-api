# NobleBid PROD stage -> GitHub secrets/variables (names get a _PROD suffix, except the shared VAPID_* keys).
# Copy to deploy/prod.env (gitignored), fill in, then:
#   npm run env:sync -- deploy/prod.env --stage prod --dry-run
#   npm run env:sync -- deploy/prod.env --stage prod
# Empty values are skipped (never deleted on GitHub). Keys marked [S] become secrets, the rest variables.

# ---- AWS / Serverless ------------------------------------------------------
AWS_ACCESS_KEY_ID=                 # [S] deploy IAM user
AWS_SECRET_ACCESS_KEY=             # [S]
SERVERLESS_ACCESS_KEY=             # [S] Serverless Framework v4 access key (app.serverless.com)
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=                   # globally unique uploads bucket, e.g. noblebid-prod-uploads-xxxxxx

# ---- Database (Postgres) ---------------------------------------------------
DATABASE_URL=                      # [S] pooled URL used by Lambda
DIRECT_URL=                        # [S] direct URL used by `prisma migrate deploy` in CI

# ---- Auth ------------------------------------------------------------------
JWT_SECRET=                        # [S] >=32 chars, differs from REFRESH_TOKEN_SECRET
REFRESH_TOKEN_SECRET=              # [S] >=32 chars

# ---- Web app / cookies / CORS ---------------------------------------------
APP_URL=                           # public web app URL (links in emails)
CORS_ORIGINS=                      # comma list, no trailing slash; empty -> APP_URL
# Custom-domain mode: .example.com  |  no-domain mode (Next.js rewrite): leave EMPTY (host-only cookie)
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax                # lax (default) | none

# ---- Business --------------------------------------------------------------
ADMIN_EMAIL=
ALERT_EMAIL=                       # optional: CloudWatch alarm emails (confirm the SNS email once)
COMMISSION_RATE_BPS=500

# ---- Payments --------------------------------------------------------------
PAYMENT_DRIVER=razorpay            # stub | razorpay
RAZORPAY_KEY_ID=                   # [S] only when PAYMENT_DRIVER=razorpay (LIVE keys on prod, needs KYC)
RAZORPAY_KEY_SECRET=               # [S]
RAZORPAY_WEBHOOK_SECRET=           # [S]

# ---- Email / OTP -----------------------------------------------------------
EMAIL_DRIVER=ses                   # stub | ses
EMAIL_FROM=                        # SES-verified sender; required when EMAIL_DRIVER=ses
EMAIL_FROM_NAME=NobleBid
LOGO_URL=
OTP_STUB_CODE=123456

# ---- Web Push (ONE pair for both stages; never rotate) ---------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                 # [S]
VAPID_SUBJECT=mailto:admin@example.com

# ---- Optional custom API domain (leave empty until the domain exists) -------
API_DOMAIN_NAME=                   # e.g. api.example.com
API_CERTIFICATE_ARN=               # ACM certificate ARN in ap-south-1
DISABLE_DEFAULT_ENDPOINT=          # true only AFTER the domain works; default false

