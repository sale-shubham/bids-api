# NobleBid DEV stage -> GitHub secrets/variables (plain names).
# Copy to deploy/dev.env (gitignored), fill in, then:
#   npm run env:sync -- deploy/dev.env --stage dev --dry-run
#   npm run env:sync -- deploy/dev.env --stage dev
# Empty values are skipped (never deleted on GitHub). Keys marked [S] become secrets, the rest variables.

# ---- AWS / Serverless ------------------------------------------------------
AWS_ACCESS_KEY_ID=                 # [S] deploy IAM user
AWS_SECRET_ACCESS_KEY=             # [S]
SERVERLESS_ACCESS_KEY=             # [S] Serverless Framework v4 access key (app.serverless.com)
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=                   # globally unique uploads bucket, e.g. noblebid-dev-uploads-xxxxxx

# ---- Database (Postgres) ---------------------------------------------------
DATABASE_URL=                      # [S] pooled URL used by Lambda
DIRECT_URL=                        # [S] direct URL used by `prisma migrate deploy` in CI

# ---- Auth ------------------------------------------------------------------
JWT_SECRET=                        # [S] >=32 chars, differs from REFRESH_TOKEN_SECRET
REFRESH_TOKEN_SECRET=              # [S] >=32 chars

# ---- Web app / cookies / CORS ---------------------------------------------
APP_URL=                           # public web app URL (auction links in emails); live: https://bidsapp.shubsale.in
WEBSITE_URL=                       # public marketing website URL (support links in emails); empty -> APP_URL; live: https://noblebids.shubsale.in
CORS_ORIGINS=                      # comma list, no trailing slash; empty -> APP_URL. Express/local dev only: deployed CORS is provider.httpApi.cors.allowedOrigins in serverless.yml (keep in sync). Live: https://bidsapp.shubsale.in, https://noblebids.shubsale.in
# Custom-domain mode (live): .shubsale.in  |  no-domain mode (Next.js rewrite, optional): leave EMPTY (host-only cookie)
COOKIE_DOMAIN=.shubsale.in
COOKIE_SAMESITE=lax                # lax (default) | none

# ---- Business --------------------------------------------------------------
ADMIN_EMAIL=
ALERT_EMAIL=                       # optional: CloudWatch alarm emails (confirm the SNS email once)
COMMISSION_RATE_BPS=500

# ---- Payments --------------------------------------------------------------
PAYMENT_DRIVER=stub                # stub | razorpay
RAZORPAY_KEY_ID=                   # [S] only when PAYMENT_DRIVER=razorpay (test keys on dev)
RAZORPAY_KEY_SECRET=               # [S]
RAZORPAY_WEBHOOK_SECRET=           # [S]

# ---- Email / OTP -----------------------------------------------------------
EMAIL_DRIVER=stub                  # stub | ses
EMAIL_FROM=                        # SES-verified sender; required when EMAIL_DRIVER=ses
EMAIL_FROM_NAME=NobleBid
LOGO_URL=
OTP_STUB_CODE=123456

# ---- Web Push (ONE pair for both stages; never rotate) ---------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                 # [S]
VAPID_SUBJECT=mailto:admin@example.com

# ---- Optional custom API domain (leave empty until the domain exists) -------
API_DOMAIN_NAME=bidsapi.shubsale.in   # live custom domain (ACM cert in ap-south-1, Route 53 record -> CustomDomainTarget); empty = no-domain mode
API_CERTIFICATE_ARN=               # ACM certificate ARN in ap-south-1
DISABLE_DEFAULT_ENDPOINT=          # true only AFTER the domain works; default false

# ---- Image CDN ---------------------------------------------------------------
ENABLE_CDN=                        # true = CloudFront in front of the uploads bucket (account must be CloudFront-verified)

# ---- Dev only: raised per-IP OTP caps for CI signups (workflow default 300) --
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_OTP_IP_MAX=
