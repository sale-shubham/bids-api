<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verification code</title>
  </head>
  <body style="margin: 0; padding: 0; font-family: Arial, sans-serif; color: #333; background: #f5f5f5">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; background: #f5f5f5">
      <tr>
        <td align="center" style="padding: 20px 12px">
          <table role="presentation" align="center" width="600" cellpadding="0" cellspacing="0" border="0"
            style="width: 100%; max-width: 600px; background: #ffffff; border-radius: 8px; overflow: hidden">
            <tr>
              <td style="padding: 16px 24px; background: #2463eb; color: #ffffff; font-size: 20px; font-weight: bold">
                <% if (logoUrl) { %>
                  <img src="<%= logoUrl %>" alt="<%= fromName %>" style="max-height: 40px; width: auto; display: block; border: 0" />
                <% } else { %>
                  <%= fromName %>
                <% } %>
              </td>
            </tr>
            <tr>
              <td style="padding: 30px; text-align: left">
                <% const isReset = purpose === 'PASSWORD_RESET'; %>
                <h2 style="font-size: 1.5em; margin: 0 0 10px 0; color: #2463eb">
                  <%= isReset ? 'Reset your password' : 'Verify your email' %>
                </h2>
                <p style="font-size: 14px; margin: 0 0 12px 0">
                  <% if (isReset) { %>
                    Use the code below to reset your <%= fromName %> password:
                  <% } else { %>
                    Use the code below to verify your email and finish creating your <%= fromName %> account:
                  <% } %>
                </p>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 20px 0">
                  <tr>
                    <td bgcolor="#2463eb" style="color: #ffffff; padding: 14px 28px; font-size: 24px; letter-spacing: 4px; font-weight: bold; border-radius: 6px; text-align: center">
                      <%= code %>
                    </td>
                  </tr>
                </table>
                <p style="font-size: 14px; margin: 0 0 12px 0">
                  This code is valid for <%= expiryMinutes %> minute<%= expiryMinutes === 1 ? '' : 's' %>. Do not share it with anyone.
                </p>
                <p style="font-size: 14px; margin: 0">
                  <% if (isReset) { %>
                    If you did not ask to reset your password, you can ignore this email - your password will not change.
                  <% } else { %>
                    If you did not create a <%= fromName %> account, you can ignore this email.
                  <% } %>
                </p>
                <div style="border-top: 1px solid #eee; padding-top: 16px; margin-top: 30px; font-size: 13px; color: #666">
                  Questions? <a href="<%= frontendUrl %>/contact" style="color: #2463eb">Contact our support team</a>.
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
