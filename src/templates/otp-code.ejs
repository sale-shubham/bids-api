<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verification Code</title>
  </head>
  <body style="margin: 0; padding: 0; font-family: Arial, sans-serif; color: #333; background: #f5f5f5">
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      border="0"
      style="width: 100%; background: #f5f5f5"
    >
      <tr>
        <td align="center" style="padding: 20px 12px">
          <table
            role="presentation"
            align="center"
            width="600"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              width: 100%;
              max-width: 600px;
              background: #ffffff;
              border-radius: 8px;
              box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
              overflow: hidden;
            "
          >
            <!-- Logo Section -->
            <tr>
              <td style="padding: 15px 20px; text-align: left; background: #2463eb">
                <% if (logoUrl) { %>
                  <img
                    src="<%= logoUrl %>"
                    alt="<%= fromName %>"
                    style="
                      max-height: 40px;
                      width: auto;
                      display: block;
                      background: #ffffff;
                      border-radius: 50px;
                      border: 0;
                      outline: none;
                      text-decoration: none;
                    "
                  />
                <% } %>
              </td>
            </tr>

            <!-- Body Section -->
            <tr>
              <td style="padding: 30px; text-align: left">
                <h2 style="font-size: 1.5em; font-weight: 600; margin: 0 0 10px 0; color: #2463eb">
                  Your <span style="color: #2463eb">Verification Code</span>
                </h2>

                <!-- Intro text -->
                <p style="font-size: 14px; font-weight: 300; margin: 0 0 12px 0">
                  Use the code below to verify your email on <%= fromName %>:
                </p>

                <!-- Code Box -->
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 20px 0">
                  <tr>
                    <td
                      bgcolor="#2463eb"
                      style="
                        color: #ffffff;
                        padding: 14px 28px;
                        font-size: 24px;
                        letter-spacing: 4px;
                        font-weight: bold;
                        border-radius: 6px;
                        text-align: center;
                      "
                    >
                      <%= code %>
                    </td>
                  </tr>
                </table>

                <!-- Validity -->
                <p style="font-size: 14px; font-weight: 300; margin: 0 0 12px 0">
                  This code is valid for <%= expiryMinutes %> minute<%= expiryMinutes === 1 ? '' : 's' %>. Do not share it with anyone.
                </p>

                <!-- Didn't request code -->
                <div style="margin: 20px 0 30px 0; font-size: 14px">
                  Didn't request this code?
                  <a href="<%= frontendUrl %>/contact" style="color: #2463eb; text-decoration: underline">
                    Contact us immediately.
                  </a>
                </div>

                <!-- Details -->
                <div
                  style="
                    border-top: 1px solid #eee;
                    padding-top: 20px;
                    margin-top: 30px;
                    font-size: 14px;
                    font-weight: 300;
                  "
                >
                  If you're having trouble using the code or have questions, please reach out to our
                  support team.
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
