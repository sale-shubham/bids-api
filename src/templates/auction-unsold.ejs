<%- include('_head', { heading: locals.reserveNotMet ? 'Your auction ended below your reserve' : 'Your auction ended without bids', logoUrl, fromName }) %>
                <p style="font-size: 14px; margin: 0 0 12px 0">Hi <%= name %>,</p>
<% if (locals.reserveNotMet) { %>
                <p style="font-size: 14px; margin: 0 0 12px 0">
                  <strong><%= auctionTitle %></strong> received bids, but none reached your reserve price, so it was not sold.
                  You can list it again from your dashboard, for example with a lower reserve.
                </p>
<% } else { %>
                <p style="font-size: 14px; margin: 0 0 12px 0">
                  <strong><%= auctionTitle %></strong> ended without receiving any bids.
                  You can republish it with new dates from your dashboard.
                </p>
<% } %>
<%- include('_foot', { ctaUrl: auctionUrl, ctaLabel: 'View auction', frontendUrl }) %>
