<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 12px 0; background: #f5f8ff; border-radius: 6px; width: 100%">
  <tr>
    <td style="padding: 14px 16px; font-size: 14px; line-height: 1.6">
      <strong><%= label %></strong><br />
      <%= person.name %><br />
      <a href="mailto:<%= person.email %>" style="color: #2463eb"><%= person.email %></a><br />
      <%= person.phone || 'Phone not provided' %>
    </td>
  </tr>
</table>
